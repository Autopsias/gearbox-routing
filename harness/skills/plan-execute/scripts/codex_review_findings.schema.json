{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cross-family review findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reviewed", "findings", "priors"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FINDINGS"],
      "description": "PASS only when findings is empty."
    },
    "reviewed": {
      "type": "array",
      "description": "Every path you actually read, verbatim as the prompt listed it. The gate compares this against the list it prepared; a shortfall fails the run.",
      "items": {"type": "string"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "severity", "title", "why"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "severity": {
            "type": "string",
            "enum": ["blocker", "critical", "high", "medium", "low", "info"]
          },
          "title": {"type": "string", "description": "One short phrase naming the defect."},
          "why": {"type": "string", "description": "The defect and its evidence, one or two sentences."}
        }
      }
    },
    "priors": {
      "type": "array",
      "description": "One entry per finding the PRIOR REVIEW section lists, by its id. A prior you leave out is treated as still OPEN.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["fixed", "open"]},
          "evidence": {"type": "string", "description": "One line: what in the code shows the status."}
        }
      }
    }
  }
}
